# Supabase (browser + server). Authorization is enforced by RLS, so no service-role key is needed.
# On Fly these NEXT_PUBLIC_* values are build args in fly.toml, because Next.js inlines them at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# OpenAI key used by the itinerary generator.
OPENAI_API_KEY=your-openai-api-key
# Optional: override the model (default gpt-6-luna). The old gpt-4o snapshots shut down on 2027-01-14.
# OPENAI_MODEL=gpt-6-luna

# Public URL of the deployed site; used for the sign-out redirect and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
